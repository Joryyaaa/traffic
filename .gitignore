*.zip.sb3

# osmnx HTTP response cache, created by scripts/fetch_osm_data.py.
cache/

# Local map-preview cache and QA frame grabs (final MP4s are committed).
results/abha_hotspot_scenarios/map_preview_videos/_tile_cache/
results/abha_hotspot_scenarios/map_preview_videos/*_qa.png
results/abha_hotspot_scenarios/map_preview_videos/*_frame.png
tmp/park_directed_probe/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
.mplconfig/

# Per-segment flow geometry from the scenario runners. This is the input
# streets layer plus two computed columns, it is 19.5MB for one Jabal Soudah
# package against a 23MB repo, and it regenerates in 13s from the committed
# configs. The numbers themselves are kept: metrics.json and segment_flows.csv
# are committed. No results/**/*.geojson has ever been tracked here.
results/**/segment_flows.geojson

# OSM-built Event Hotspot street layers. 5.3MB, and scripts/build_abha_event_osm_network.py
# regenerates them in about a minute, validated by the committed qa_report.json.
# The tiny origin/destination point layers ARE committed: they pin the scenario.
data/abha_event_hotspot_osm/B0_baseline_streets.geojson
data/abha_event_hotspot_osm/S1_vehicle_restriction_streets.geojson
