# Data & outputs (keep small samples only, use DVC/LFS for big files)
# Raw data is ignored by default. Keep only the compact, reproducible Abha
# Ibex inputs in Git so the checked-in Slurm configs do not point to files
# that are missing on the cluster. Both sets of exceptions below are load
# bearing: dropping either side's would silently un-track data its own branch
# committed, so they are kept together rather than merged down.
data/raw/*
# Jabal Soudah package
!data/raw/abha_full_belt_s0/
data/raw/abha_full_belt_s0/*
!data/raw/abha_full_belt_s0/streets.geojson
!data/raw/abha_full_belt_s0/residential.geojson
!data/raw/abha_full_belt_s0/amenities.geojson
!data/raw/abha_full_belt_s0/qa_report.json
!data/raw/abha_full_belt_s0/approved_main_corridors.geojson
!data/raw/abha_khamis_soudah_demand/
data/raw/abha_khamis_soudah_demand/*
!data/raw/abha_khamis_soudah_demand/corridor_allowed_streets.geojson
!data/raw/abha_khamis_soudah_demand/*_origins.geojson
!data/raw/abha_khamis_soudah_demand/al_soudah_destination.geojson
!data/raw/abha_khamis_soudah_demand/demand_qa.json
# Named-site hotspot package
!data/raw/abha_hotspot_pois/
!data/raw/abha_hotspot_pois/**
!data/raw/abha_hotspots/
!data/raw/abha_hotspots/**
data/interim/
data/processed/
Cities/
runs/
logs/
outputs/
*.zip
*.gpkg
*.shp
*.shx
*.dbf
*.tif

